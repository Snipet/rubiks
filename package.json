{
	"name": "cubecraft",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "An interactive guide to solving the Rubik's Cube — lessons, a searchable algorithm library, and a cube-state analyzer.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^22.13.5",
		"eslint": "^9.21.0",
		"eslint-plugin-svelte": "^3.0.2",
		"prettier": "^3.5.2",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.20.5",
		"svelte-check": "^4.1.4",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.25.0",
		"vite": "^7.1.5",
		"vitest": "^4.1.10"
	}
}
